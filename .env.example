APP_NAME="Football Intel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=football_intel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AI — laravel/ai SDK
# -----------------------------------------------------------------------------
# Real API keys (leave blank in CI / test envs — fakes handle those).
ANTHROPIC_API_KEY=
VOYAGEAI_API_KEY=

# Ollama — LAN device running the free local models. Override per machine
# if you're not on this network, or leave blank if you won't use Ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_API_KEY=ollama

# n8n Claude proxy — webhook URL for a workflow that wraps a Claude
# CLI. Set this and flip AI_PROVIDER_CLASSIFIER / AI_PROVIDER_EXTRACTOR
# to "n8n" to route the agents through the proxy instead of laravel/ai's
# native providers. Lets you reuse a Claude subscription without a
# separate Anthropic API key. Wire shape is GET-with-body — see
# App\Services\Ai\N8nClaudeGateway.
AI_N8N_URL=
AI_N8N_TIMEOUT=300

# Per-task overrides. Each agent reads config('ai.football_intel.*')
# which defaults to these. Swap Claude for Ollama on any task by
# setting the matching AI_PROVIDER_* to 'ollama' and AI_MODEL_* to a
# local model name (e.g. qwen3:14b for extraction, llama3.2-vision:11b
# for OCR). See config/ai.php for the full list.
# AI_PROVIDER_CLASSIFIER=anthropic
# AI_PROVIDER_EXTRACTOR=anthropic
# AI_PROVIDER_NUTRITIONIST=anthropic
# AI_PROVIDER_VISION=anthropic
# AI_PROVIDER_EMBEDDING=voyageai
# AI_MODEL_CLASSIFIER=claude-haiku-4-5
# AI_MODEL_EXTRACTOR=claude-opus-4-7
# AI_MODEL_NUTRITIONIST=claude-opus-4-7
# AI_MODEL_VISION=claude-opus-4-7
# AI_MODEL_EMBEDDING=voyage-3-large
# AI_EMBEDDING_DIMENSIONS=1024

# Input preprocessing per agent. On Bahraini lab reports, Arabic is
# almost entirely boilerplate (addresses, privacy notices, duplicate
# column headers) — stripping it speeds up local models and avoids
# code-switch slowdowns. Extractor default keeps Arabic because the
# patient name + some metadata may be informative. Flip to true if
# your documents carry meaningful Arabic content the extractor
# should see.
# AI_STRIP_ARABIC_CLASSIFIER=true
# AI_STRIP_ARABIC_EXTRACTOR=false

# Optional classifier prompt cap. Default is 0 = no cap (send the
# full document). Set a positive value when running against smaller
# local models that get slow on long prompts — Ollama 14B on LAN
# usually wants 3000–4000. Claude Haiku never needs it.
# AI_CLASSIFIER_MAX_CHARS=0
